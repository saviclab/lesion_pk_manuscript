# packages
library(tidyverse)
# directories
WD <- "~/Documents/Pharmactuarials/Cytomx/" # local master path
wd_parsed <- "Data/Parsed/"
wd_save <- "Data/Parsed/Sim/"
pk_data <- read.csv(paste0(WD, wd_parsed, "VARSETAM_PK_20260807.csv"))
colnames(pk_data)
set.seed(1234)
# bootstrap population
n_sim <- 1000
sim_pop <- pk_data %>%
select(SEXN, HT, WT) %>%
filter(HT >0) %>% # had to impute 3 missing hts
group_by(SEXN) %>%
slice_sample(n = n_sim/2, # 50-50 male-female
replace = TRUE) %>%
ungroup() %>%
mutate(ID = row_number())
table(sim_pop$SEXN)
sim_pop2 <- bind_rows(
# repeat IDs for each dosing strategy
sim_pop %>%
mutate(REGIMEN = "650FLAT",
ID = ID),
sim_pop %>%
mutate(REGIMEN = "ABW100CAP",
ID = ID + n_sim),
sim_pop %>%
mutate(REGIMEN = "AIBW",
ID = ID + 2*n_sim)) %>%
# calculate IBW and AIBW
mutate(HT_in = HT / 2.54,
IBW =
case_when(SEXN == 1 ~ 50 + 2.3*(HT_in - 60), # male
SEXN == 2 ~ 45.5 + 2.3*(HT_in - 60)), # female
AIBW = IBW + 0.4*(WT - IBW),
AIBW = pmin(AIBW, WT),
# calculate dose for each dosing strategy
DOSEMG = case_when(REGIMEN == "650FLAT" ~ 650,
REGIMEN == "ABW100CAP" ~ 8.6*pmin(WT,100), # if WT <100 kg, use ABW; >= 100 kg, use 100 kg
REGIMEN == "AIBW" ~ 8.6*pmin(AIBW,100)))
tau <- 21*24
n_cycles <- 6
dosing <- sim_pop2 %>%
select(ID, REGIMEN, DOSEMG) %>%
crossing(CYCLE = 1:n_cycles) %>%
mutate(TIME = (CYCLE - 1) * tau,
TAD = 0,
EVID = 1,
MDV = 1,
CMT = 1,
PCTEST = 0,
AMTMG = DOSEMG,
RATEMGH = AMTMG) # assuming 1 hour infusion
obs_times <- c(0, 0.25, 1, 4, 6, 8, 12, seq(24, 504, 24))
obs <- sim_pop2 %>%
select(ID, DOSEMG, REGIMEN) %>%
crossing(CYCLE = 1:n_cycles,
TAD = obs_times,
PCTEST = c(4, 1)) %>%   # add analytes here
mutate(TIME = (CYCLE - 1) * tau + TAD,
EVID = 0,
MDV = 0,
CMT = 1,
AMTMG = 0,
RATEMGH = 0) %>%
select(ID, REGIMEN, DOSEMG, CYCLE, TIME, TAD, EVID, MDV, CMT, PCTEST, AMTMG, RATEMGH)
sim_data <- rbind(dosing, obs) %>%
left_join(sim_pop2, by = c("ID", "DOSEMG", "REGIMEN")) %>%
mutate(REGIMEN2 =
ifelse(REGIMEN=="650FLAT", 1,
ifelse(REGIMEN=="ABW100CAP", 2, 3))) %>%
mutate(DVMGL = 0) %>%
select(ID, TAD, TIME, AMTMG, RATEMGH, DVMGL, PCTEST, CYCLE, EVID, MDV, CMT, DOSEMG, REGIMEN2, SEXN, HT, WT, IBW, AIBW) %>%
arrange(ID, TIME, EVID)
write_csv(sim_data, paste0(WD, wd_save, "VARSETAM_PK_SIM_20260808.csv"))
#### set up
library(tidyverse)
WD <- "/Volumes/savic/translational_team/apatel/Lesion_Manuscript/All_LesionPK_Data/"
#### read in data
rabbit_data <- read.csv(paste0(WD, "rabbit_lesion_pk.csv")) %>% # rabbit
# rename
mutate(DRUG =
ifelse(DRUG=="GSK-656", "GFB",
ifelse(DRUG=="mCLB-073", "TBD-11",
ifelse(DRUG=="OPC-167832", "QBD", DRUG))))
human_data <- read.csv(paste0(WD, "human_lesion_pk.csv")) # human
# get unique IDs
human_n_subj <- human_data %>%
group_by(DRUG) %>%
distinct(CID) %>%
summarise(N_SUBJ = n())
rabbit_n_subj <- rabbit_data %>%
group_by(DRUG) %>%
distinct(CID) %>%
summarise(N_SUBJ = n())
#### summarize data by lesion type
rabbit_lesion_types <- as.data.frame.matrix(table(rabbit_data$DRUG, rabbit_data$LESIONGROUP))
human_lesion_types <- as.data.frame.matrix(table(human_data$DRUG, human_data$LESIONGROUP))
View(rabbit_lesion_types)
# save
write_csv(rabbit_lesion_types, paste0(WD, "rabbit_n_samples_by_lesion.csv"))
write_csv(human_lesion_types, paste0(WD, "human_n_samples_by_lesion.csv"))
#### summarize data by PK sampling time
rabbit_lesion_n_times <- rabbit_data %>%
mutate(TIME_BIN = round(TIME)) %>%
group_by(DRUG) %>%
distinct(TIME_BIN) %>%
filter(TIME_BIN >0) %>%
summarise(TIME_POINTS = n())
rabbit_lesion_time_range <- rabbit_data %>%
group_by(DRUG) %>%
distinct(TAD) %>%
summarise(MIN_TAD = min(TAD, na.rm = TRUE),
MAX_TAD = max(TAD,  na.rm = TRUE)) %>%
mutate(RANGE = paste0("'", round(MIN_TAD, 1), "-", round(MAX_TAD, 1)))
human_lesion_n_times <- human_data %>%
mutate(TIME_BIN = round(TIME)) %>%
group_by(DRUG) %>%
distinct(TIME_BIN) %>%
filter(TIME_BIN >0) %>%
summarise(TIME_POINTS = n())
human_lesion_time_range <- human_data %>%
group_by(DRUG) %>%
distinct(TAD) %>%
summarise(MIN_TAD = min(TAD, na.rm = TRUE),
MAX_TAD = max(TAD,  na.rm = TRUE)) %>%
mutate(RANGE = paste0("'", round(MIN_TAD, 1), "-", round(MAX_TAD, 1)))
# save
write_csv(rabbit_lesion_n_times, paste0(WD, "rabbit_n_sampling_times.csv"))
write_csv(human_lesion_n_times, paste0(WD, "human_n_sampling_times.csv"))
write_csv(rabbit_lesion_time_range, paste0(WD, "rabbit_sampling_time_range.csv"))
write_csv(human_lesion_time_range, paste0(WD, "human_sampling_time_range.csv"))
View(human_n_subj)
View(rabbit_lesion_n_times)
View(rabbit_lesion_types)
