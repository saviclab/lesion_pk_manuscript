geom_jitter(width = 0.15, alpha = 0.2, size = 1) +
scale_y_log10() +
facet_wrap(~BMI_cat) +
scale_color_manual(values = c("darkred", "darkgreen", "darkblue")) +
scale_fill_manual(values = c("darkred", "darkgreen", "darkblue")) +
labs(x = NULL, y = "Css,avg (mg/L)") +
theme_bw() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "none")
tab_plot$reg_label <- factor(tab_plot$reg_label, levels = c("Flat 650 mg", "Weight-based 8.6 mg/kg/n(100 kg cap)", "AIBW 8.6 mg/kg"))
tab_plot <- tab %>%
mutate(BMI = WT/(HT/100)^2) %>%
filter(CYCLE==6, # steady-state AUC
TIME %in% c(2520, 3024), # tau = 504 h
EVID==0,
PCTEST==4) %>% # for Total Probody only
group_by(ID) %>%
mutate(AUCT0tau =
lead(AUCT) - AUCT) %>%
mutate(Css_avg = AUCT0tau/504) %>%
mutate(BMI_cat =
ifelse(BMI >=30, "BMI >=30", "BMI <30")) %>%
mutate(reg_label =
ifelse(REGIMEN2==1, "Flat 650 mg",
ifelse(REGIMEN2==2, "Weight-based\n8.6 mg/kg (100 kg cap)", "AIBW 8.6 mg/kg"))) %>%
filter(!is.na(Css_avg))
