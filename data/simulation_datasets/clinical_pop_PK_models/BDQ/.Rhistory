# set up
library(tidyverse)
library(xpose)
# read in nm sim tab
tab <- read_nm_table(paste0(WD, "BDQ/Final_Sim/sdtab663"))
# set up
library(tidyverse)
library(xpose)
# read in nm sim tab
tab <- read_nm_table(paste0(WD, "BDQ/Final_Sim/sdtab663"))
library(xpose4)
# read in nm sim tab
tab <- read_nm_table(paste0(WD, "BDQ/Final_Sim/sdtab663"))
WD <- "/Volumes/savic/translational_team/apatel/Lesion_Manuscript/Clinical_PopPK_Models/"
# read in nm sim tab
tab <- read_nm_table(paste0(WD, "BDQ/Final_Sim/sdtab663"))
tab %>% ggplot(mapping = aes(x = TIME, y = CPplasma, group = factor(DOSE), color = as.factor(DOSE)))+
geom_line()
# filter for AUC
tab_auc_adj <- tab %>%
filter(FLAG==2)  %>% # remove duplicated rows
select(DOSE, TIME, AUCPplasma, AUCPlung, AUCPcell, AUCPcaseum,
AUCM2plasma, AUCM2lung, AUCM2cell, AUCM2caseum) %>%
filter(TIME %in% c(2664, 2688)) %>%
group_by(DOSE) %>%
mutate(AUCss_plasma_parent = lead(AUCPplasma) - AUCPplasma,
AUCss_lung_parent = lead(AUCPlung) - AUCPlung,
AUCss_cell_parent = lead(AUCPcell) - AUCPcell,
AUCss_caseum_parent = lead(AUCPcaseum) - AUCPcaseum,
AUCss_plasma_metab = lead(AUCM2plasma) - AUCM2plasma,
AUCss_lung_metab = lead(AUCM2lung) - AUCM2lung,
AUCss_cell_metab = lead(AUCM2cell) - AUCM2cell,
AUCss_caseum_metab = lead(AUCM2caseum) - AUCM2caseum) %>%
mutate(Css_plasma_parent = AUCss_plasma_parent/24,
Css_lung_parent = AUCss_lung_parent/24,
Css_cell_parent = AUCss_cell_parent/24,
Css_caseum_parent = AUCss_caseum_parent/24,
Css_plasma_metab = AUCss_plasma_metab/24,
Css_lung_metab = AUCss_lung_metab/24,
Css_cell_metab = AUCss_cell_metab/24,
Css_caseum_metab = AUCss_caseum_metab)
# remove rows with NAs
tab_auc_adj2 <- na.omit(tab_auc_adj) %>%
# remove rows we don't need
select(-c(AUCPplasma, AUCPlung, AUCPcell, AUCPcaseum,
AUCM2plasma, AUCM2lung, AUCM2cell, AUCM2caseum))
# pivot dataframe
tab_auc <- pivot_longer(tab_auc_adj2, cols = -c("DOSE", "TIME"), names_to = "EXPOSURE", values_to = "VALUE") %>%
select(-TIME)
# filter for Cmin
tab_cmin_adj <- tab %>%
filter(FLAG==2)  %>% # remove duplicated rows
select(DOSE, TIME, CPplasma, CPlung, CPcell, CPcaseum,
CM2plasma, CM2lung, CM2cell, CM2caseum) %>%
filter(TIME >=2664)
# plot check
ggplot(data = filter(tab_cmin_adj, DOSE==200)) +
geom_line(mapping = aes(x = TIME, y = CM2caseum, group = as.factor(DOSE))) +
scale_x_continuous(breaks = seq(2664, 2688, 4)) #+
tab_cmin_adj2 <- tab_cmin_adj %>%
group_by(DOSE) %>%
summarize(Cmin_parent_plasma = min(CPplasma),
Cmin_parent_lung = min(CPlung),
Cmin_parent_cell = min(CPcell),
Cmin_parent_caseum = min(CPcaseum),
Cmin_metab_plasma = min(CM2plasma),
Cmin_metab_lung = min(CM2lung),
Cmin_metab_cell = min(CM2cell),
Cmin_metab_caseum = min(CM2caseum))
# pivot dataframe
tab_cmin <- pivot_longer(tab_cmin_adj2, cols = -c("DOSE"), names_to = "EXPOSURE", values_to = "VALUE")
# filter for Cmax and Tmax (doing it manually because NONMEM Tmax output is not what we want)
tab_cmax_tmax_adj <- tab %>%
group_by(DOSE) %>%
summarize(Cmax_parent_plasma = max(CPplasma),
Tmax_parent_plasma = TAD[which.max(CPplasma)],
Cmax_parent_lung = max(CPlung),
Tmax_parent_lung = TAD[which.max(CPlung)],
Cmax_parent_cell = max(CPcell),
Tmax_parent_cell = TAD[which.max(CPcell)],
Cmax_parent_caseum = max(CPcaseum),
Tmax_parent_caseum = TAD[which.max(CPcaseum)],
Cmax_metab_plasma = max(CM2plasma),
Tmax_metab_plasma = TAD[which.max(CM2plasma)],
Cmax_metab_lung = max(CM2lung),
Tmax_metab_lung = TAD[which.max(CM2lung)],
Cmax_metab_cell = max(CM2cell),
Tmax_metab_cell = TAD[which.max(CM2cell)],
Cmax_metab_caseum = max(CM2caseum),
Tmax_metab_caseum = TAD[which.max(CM2caseum)]) %>%
ungroup()
# pivot dataframe
tab_cmax_tmax <- pivot_longer(tab_cmax_tmax_adj, cols = -c("DOSE"), names_to = "EXPOSURE", values_to = "VALUE")
# bind all exposure outputs
tab_exposures <- rbind(tab_auc, tab_cmin, tab_cmax_tmax) %>%
arrange(DOSE)
# reformat dataframe
tab_exposures_final <- tab_exposures %>%
mutate(DRUG =
ifelse(grepl("parent", EXPOSURE), "BDQ", "BDQ-M2")) %>%
mutate(LESIONNAME =
ifelse(grepl("plasma", EXPOSURE), "Plasma",
ifelse(grepl("lung", EXPOSURE), "Lung",
ifelse(grepl("cell", EXPOSURE), "Cellular lesion", "Caseum")))) %>%
mutate(EXPOSURE2 =
ifelse(grepl("AUCss", EXPOSURE), "AUCss_0_24",
ifelse(grepl("Cmax", EXPOSURE), "Cmax",
ifelse(grepl("Cmin", EXPOSURE), "Cmin",
ifelse(grepl("Tmax", EXPOSURE), "Tmax", "Css"))))) %>%
select(-EXPOSURE) %>%
pivot_wider(id_cols = c(DRUG, LESIONNAME, DOSE), names_from = "EXPOSURE2", values_from = "VALUE") %>%
select(c(DRUG, DOSE, LESIONNAME, Cmax, Tmax, AUCss_0_24, Cmin)) %>%
arrange(DRUG, DOSE)
# save dataset
write_csv(tab_exposures_final, paste0(WD, "BDQ/bdq_exposures.csv"))
# set up
library(tidyverse)
library(xpose)
library(xpose4)
WD <- "/Volumes/savic/translational_team/apatel/Lesion_Manuscript/Clinical_PopPK_Models/"
# read in nm sim tab
tab <- read_nm_table(paste0(WD, "TBAJ-587/Final_Sim/sdtab7")) %>%
# convert dose column from mmol to mg
mutate(DOSE = ifelse(AMT>0, round(DOSE*614.5, 1), NA)) %>%
fill(DOSE, .direction = "down")
# plot data
ggplot(data = tab) +
geom_point(mapping = aes(x = TIME, y = CPplasma, color = as.factor(DOSE)))
# filter for AUC
tab_auc_adj <- tab %>%
filter(METAB==2)  %>% # remove duplicated rows
select(DOSE, TIME, AUCPplasma, AUCPlung, AUCPcell, AUCPcaseum,
AUCM3plasma, AUCM3lung, AUCM3cell, AUCM3caseum) %>%
filter(TIME %in% c(2664, 2688)) %>%
group_by(DOSE) %>%
mutate(AUCss_plasma_parent = lead(AUCPplasma) - AUCPplasma,
AUCss_lung_parent = lead(AUCPlung) - AUCPlung,
AUCss_cell_parent = lead(AUCPcell) - AUCPcell,
AUCss_caseum_parent = lead(AUCPcaseum) - AUCPcaseum,
AUCss_plasma_metab = lead(AUCM3plasma) - AUCM3plasma,
AUCss_lung_metab = lead(AUCM3lung) - AUCM3lung,
AUCss_cell_metab = lead(AUCM3cell) - AUCM3cell,
AUCss_caseum_metab = lead(AUCM3caseum) - AUCM3caseum) %>%
mutate(Css_plasma_parent = AUCss_plasma_parent/24,
Css_lung_parent = AUCss_lung_parent/24,
Css_cell_parent = AUCss_cell_parent/24,
Css_caseum_parent = AUCss_caseum_parent/24,
Css_plasma_metab = AUCss_plasma_metab/24,
Css_lung_metab = AUCss_lung_metab/24,
Css_cell_metab = AUCss_cell_metab/24,
Css_caseum_metab = AUCss_caseum_metab)
# remove rows with NAs
tab_auc_adj2 <- na.omit(tab_auc_adj) %>%
# remove rows we don't need
select(-c(AUCPplasma, AUCPlung, AUCPcell, AUCPcaseum,
AUCM3plasma, AUCM3lung, AUCM3cell, AUCM3caseum))
# pivot dataframe
tab_auc <- pivot_longer(tab_auc_adj2, cols = -c("DOSE", "TIME"), names_to = "EXPOSURE", values_to = "VALUE") %>%
select(-TIME)
# filter for Cmin
tab_cmin_adj <- tab %>%
filter(METAB==2)  %>% # remove duplicated rows
select(DOSE, TIME, CPplasma, CPlung, CPcell, CPcaseum,
CM3plasma, CM3lung, CM3cell, CM3caseum) %>%
filter(TIME >=2664)
ggplot(data = filter(tab_cmin_adj, DOSE==25)) +
geom_line(mapping = aes(x = TIME, y = CM3caseum, group = as.factor(DOSE))) +
scale_x_continuous(breaks = seq(2664, 2688, 4))
tab_cmin_adj2 <- tab_cmin_adj %>%
group_by(DOSE) %>%
summarize(Cmin_parent_plasma = min(CPplasma),
Cmin_parent_lung = min(CPlung),
Cmin_parent_cell = min(CPcell),
Cmin_parent_caseum = min(CPcaseum),
Cmin_metab_plasma = min(CM3plasma),
Cmin_metab_lung = min(CM3lung),
Cmin_metab_cell = min(CM3cell),
Cmin_metab_caseum = min(CM3caseum))
# pivot dataframe
tab_cmin <- pivot_longer(tab_cmin_adj2, cols = -c("DOSE"), names_to = "EXPOSURE", values_to = "VALUE")
# filter for Cmax and Tmax (doing it manually because NONMEM Tmax output is not what we want)
tab_cmax_tmax_adj <- tab %>%
group_by(DOSE) %>%
summarize(Cmax_parent_plasma = max(CPplasma),
Tmax_parent_plasma = TAD[which.max(CPplasma)],
Cmax_parent_lung = max(CPlung),
Tmax_parent_lung = TAD[which.max(CPlung)],
Cmax_parent_cell = max(CPcell),
Tmax_parent_cell = TAD[which.max(CPcell)],
Cmax_parent_caseum = max(CPcaseum),
Tmax_parent_caseum = TAD[which.max(CPcaseum)],
Cmax_metab_plasma = max(CM3plasma),
Tmax_metab_plasma = TAD[which.max(CM3plasma)],
Cmax_metab_lung = max(CM3lung),
Tmax_metab_lung = TAD[which.max(CM3lung)],
Cmax_metab_cell = max(CM3cell),
Tmax_metab_cell = TAD[which.max(CM3cell)],
Cmax_metab_caseum = max(CM3caseum),
Tmax_metab_caseum = TAD[which.max(CM3caseum)]) %>%
ungroup()
# pivot dataframe
tab_cmax_tmax <- pivot_longer(tab_cmax_tmax_adj, cols = -c("DOSE"), names_to = "EXPOSURE", values_to = "VALUE")
# bind all exposure outputs
tab_exposures <- rbind(tab_auc, tab_cmin, tab_cmax_tmax) %>%
arrange(DOSE)
# reformat dataframe
tab_exposures_final <- tab_exposures %>%
mutate(DRUG =
ifelse(grepl("parent", EXPOSURE), "TBAJ-587", "TBAJ-587-M3")) %>%
mutate(LESIONNAME =
ifelse(grepl("plasma", EXPOSURE), "Plasma",
ifelse(grepl("lung", EXPOSURE), "Lung",
ifelse(grepl("cell", EXPOSURE), "Cellular lesion", "Caseum")))) %>%
mutate(EXPOSURE2 =
ifelse(grepl("AUCss", EXPOSURE), "AUCss_0_24",
ifelse(grepl("Cmax", EXPOSURE), "Cmax",
ifelse(grepl("Cmin", EXPOSURE), "Cmin",
ifelse(grepl("Tmax", EXPOSURE), "Tmax", "Css"))))) %>%
select(-EXPOSURE) %>%
pivot_wider(id_cols = c(DRUG, LESIONNAME, DOSE), names_from = "EXPOSURE2", values_from = "VALUE") %>%
select(c(DRUG, DOSE, LESIONNAME, Cmax, Tmax, AUCss_0_24, Cmin)) %>%
arrange(DRUG, DOSE)
# save dataset
write_csv(tab_exposures_final, paste0(WD, "TBAJ-587/tbaj587_exposures.csv"))
# set up
library(tidyverse)
library(xpose)
library(xpose4)
WD <- "/Volumes/savic/translational_team/apatel/Lesion_Manuscript/Clinical_PopPK_Models/"
# read in nm sim tab
tab <- read_nm_table(paste0(WD, "TBAJ-876/Final_Sim/sdtab0547"))
# plot data
ggplot(data = tab) +
geom_line(mapping = aes(x = TIME, y = Cparent, color = as.factor(DOSE)))
# filter for AUC
tab_auc_adj <- tab %>%
filter(METAB==2)  %>% # remove duplicated rows
select(DOSE, TIME, AUC_parent, AUC_parent_lung, AUC_parent_cell, AUC_parent_caseum,
AUC_metab, AUC_metab_lung, AUC_metab_cell, AUC_metab_caseum) %>%
filter(TIME %in% c(2664, 2688)) %>%
group_by(DOSE) %>%
mutate(AUCss_plasma_parent = lead(AUC_parent) - AUC_parent,
AUCss_lung_parent = lead(AUC_parent_lung) - AUC_parent_lung,
AUCss_cell_parent = lead(AUC_parent_cell) - AUC_parent_cell,
AUCss_caseum_parent = lead(AUC_parent_caseum) - AUC_parent_caseum,
AUCss_plasma_metab = lead(AUC_metab) - AUC_metab,
AUCss_lung_metab = lead(AUC_metab_lung) - AUC_metab_lung,
AUCss_cell_metab = lead(AUC_metab_cell) - AUC_metab_cell,
AUCss_caseum_metab = lead(AUC_metab_caseum) - AUC_metab_caseum) %>%
mutate(Css_plasma_parent = AUCss_plasma_parent/24,
Css_lung_parent = AUCss_lung_parent/24,
Css_cell_parent = AUCss_cell_parent/24,
Css_caseum_parent = AUCss_caseum_parent/24,
Css_plasma_metab = AUCss_plasma_metab/24,
Css_lung_metab = AUCss_lung_metab/24,
Css_cell_metab = AUCss_cell_metab/24,
Css_caseum_metab = AUCss_caseum_metab)
# remove rows with NAs
tab_auc_adj2 <- na.omit(tab_auc_adj) %>%
# remove rows we don't need
select(-c(AUC_parent, AUC_parent_lung, AUC_parent_cell, AUC_parent_caseum,
AUC_metab, AUC_metab_lung, AUC_metab_cell, AUC_metab_caseum))
# pivot dataframe
tab_auc <- pivot_longer(tab_auc_adj2, cols = -c("DOSE", "TIME"), names_to = "EXPOSURE", values_to = "VALUE") %>%
select(-TIME)
# filter for Cmin
tab_cmin_adj <- tab %>%
filter(METAB==2)  %>% # remove duplicated rows
select(DOSE, TIME, Cparent, Cparentlung, Cparentcellular, Cparentcaseum,
Cmetab, Cmetalung, Cmetacellular, Cmetacaseum) %>%
filter(TIME >=2664)
ggplot(data = filter(tab_cmin_adj, DOSE==100)) +
geom_line(mapping = aes(x = TIME, y = Cmetalung, group = as.factor(DOSE))) +
scale_x_continuous(breaks = seq(2664, 2688, 4))
tab_cmin_adj2 <- tab_cmin_adj %>%
group_by(DOSE) %>%
summarize(Cmin_parent_plasma = min(Cparent),
Cmin_parent_lung = min(Cparentlung),
Cmin_parent_cell = min(Cparentcellular),
Cmin_parent_caseum = min(Cparentcaseum),
Cmin_metab_plasma = min(Cmetab),
Cmin_metab_lung = min(Cmetalung),
Cmin_metab_cell = min(Cmetacellular),
Cmin_metab_caseum = min(Cmetacaseum)) # all at time 2688 h
# pivot dataframe
tab_cmin <- pivot_longer(tab_cmin_adj2, cols = -c("DOSE"), names_to = "EXPOSURE", values_to = "VALUE")
# filter for Cmax and Tmax (doing it manually because NONMEM Tmax output is not what we want)
tab_cmax_tmax_adj <- tab %>%
group_by(DOSE) %>%
summarize(Cmax_parent_plasma = max(Cparent),
Tmax_parent_plasma = TAD[which.max(Cparent)],
Cmax_parent_lung = max(Cparentlung),
Tmax_parent_lung = TAD[which.max(Cparentlung)],
Cmax_parent_cell = max(Cparentcellular),
Tmax_parent_cell = TAD[which.max(Cparentcellular)],
Cmax_parent_caseum = max(Cparentcaseum),
Tmax_parent_caseum = TAD[which.max(Cparentcaseum)],
Cmax_metab_plasma = max(Cmetab),
Tmax_metab_plasma = TAD[which.max(Cmetab)],
Cmax_metab_lung = max(Cmetalung),
Tmax_metab_lung = TAD[which.max(Cmetalung)],
Cmax_metab_cell = max(Cmetacellular),
Tmax_metab_cell = TAD[which.max(Cmetacellular)],
Cmax_metab_caseum = max(Cmetacaseum),
Tmax_metab_caseum = TAD[which.max(Cmetacaseum)]) %>%
ungroup()
# pivot dataframe
tab_cmax_tmax <- pivot_longer(tab_cmax_tmax_adj, cols = -c("DOSE"), names_to = "EXPOSURE", values_to = "VALUE")
# bind all exposure outputs
tab_exposures <- rbind(tab_auc, tab_cmin, tab_cmax_tmax) %>%
arrange(DOSE)
# reformat dataframe
tab_exposures_final <- tab_exposures %>%
mutate(DRUG =
ifelse(grepl("parent", EXPOSURE), "TBAJ-876", "TBAJ-876-M3")) %>%
mutate(LESIONNAME =
ifelse(grepl("plasma", EXPOSURE), "Plasma",
ifelse(grepl("lung", EXPOSURE), "Lung",
ifelse(grepl("cell", EXPOSURE), "Cellular lesion", "Caseum")))) %>%
mutate(EXPOSURE2 =
ifelse(grepl("AUCss", EXPOSURE), "AUCss_0_24",
ifelse(grepl("Cmax", EXPOSURE), "Cmax",
ifelse(grepl("Cmin", EXPOSURE), "Cmin",
ifelse(grepl("Tmax", EXPOSURE), "Tmax", "Css"))))) %>%
select(-EXPOSURE) %>%
pivot_wider(id_cols = c(DRUG, LESIONNAME, DOSE), names_from = "EXPOSURE2", values_from = "VALUE") %>%
select(c(DRUG, DOSE, LESIONNAME, Cmax, Tmax, AUCss_0_24, Cmin)) %>%
arrange(DRUG, DOSE)
# save dataset
write_csv(tab_exposures_final, paste0(WD, "TBAJ-876/tbaj876_exposures.csv"))
