labs(color = "Potency target") +
ylab("Percent time above target over 24 hours") +
xlab("Dose (mg)") +
ggtitle("RIF Caseum") +
scale_color_manual(values = color_mapping,
breaks = c("MIC", "macIC90", "EC50", "casMBC50")) +
theme_bw() +
theme(axis.title = element_text(size=12),
axis.text = element_text(size=10))
# get intersection per target
crossing_points <- sapply(percent_columns, function(col) {
interpolate_x(data$dose, data[[col]], target_y3)
})
names(crossing_points) <- c("MIC", "macIC90", "EC50", "casMBC50")
print(crossing_points)
# add the vertical lines and annotations for each crossing point
x_base <- max(data$dose)
y_base <- 15
y_spacing <- 5
for (i in seq_along(names(crossing_points))) {
label <- names(crossing_points)[i]
if(!is.na(crossing_points[[label]])) {
p <- p +
annotate("text", x = x_base, y = y_base - (i-1)*y_spacing,
label = paste(label, "=", round(crossing_points[[label]], 2), "mg"), hjust = 1,
color = color_mapping[label], size = 3)
}
}
p
