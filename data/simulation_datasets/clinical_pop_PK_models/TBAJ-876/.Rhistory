geom_hline(yintercept = 10, linetype="dashed") +
# annotate("text", x = 5000, y = 93, label="ED90", size=3.5) +
# annotate("text", x = 5000, y = 53, label="ED50", size=3.5) +
annotate("text", x = 5000, y = 13, label="ED10", size=3.5) +
labs(color = "Potency target", linetype = "Risk Group") +
ylab("Percent time above target over 24 hours\nSurvival probability") +
xlab("Dose (mg)") +
ggtitle("RPT Cellular Lesion") +
scale_color_manual(values = color_mapping,
breaks = c("MIC", "macIC90", "EC50", "casMBC50")) +
theme_bw() +
theme(axis.title = element_text(size=12),
axis.text = element_text(size=10))
# get intersection per target
crossing_points <- sapply(percent_columns, function(col) {
interpolate_x(data$dose, data[[col]], target_y3)
})
names(crossing_points) <- c("MIC", "macIC90", "EC50", "casMBC50")
print(crossing_points)
# add the vertical lines and annotations for each crossing point
x_base <- max(data$dose) + 100
y_base <- 35
y_spacing <- 5
for (i in seq_along(names(crossing_points))) {
label <- names(crossing_points)[i]
if(!is.na(crossing_points[[label]])) {
p <- p +
annotate("text", x = x_base, y = y_base - (i-1)*y_spacing,
label = paste(label, "=", round(crossing_points[[label]], 2), "mg"), hjust = 1,
color = color_mapping[label], size = 3)
}
}
p
ggsave(paste0(WD, wd_plots, "rpt_cell_dose_response_ed10.pdf"), width = 8, height = 5)
# tab <- read.nm.tables(paste0(WD, wd_nm, "RPT/Plasma/tab3"))
# tab <- read.nm.tables(paste0(WD, wd_nm, "RPT/Lung/tab2"))
# tab <- read.nm.tables(paste0(WD, wd_nm, "RPT/Cell/tab2"))
tab <- read.nm.tables(paste0(WD, wd_nm, "RPT/Caseum/tab2"))
obs_time <- 168
tab_plot <- tab %>%
mutate(AMT =
ifelse(AMT==0, NA, AMT)) %>%
fill(AMT, .direction = "down") %>%
group_by(ID, STDAY) %>%
mutate(perc_TAM = max(TAM)/obs_time*100,
perc_TAE = max(TAE)/obs_time*100,
perc_TAMAC = max(TAMAC)/obs_time*100,
perc_TACAS50 = max(TACAS50)/obs_time*100,
perc_TACAS90 = max(TACAS90/obs_time*100)) %>%
ungroup() %>%
select(c(ID, AMT, TIME, STDAY, CP, perc_TAM, perc_TAE, perc_TAMAC, perc_TACAS50, perc_TACAS90))
data <- tab_plot %>%
rename(dose = AMT)
# convert from decimal to percent for clinical dose-response
# clinical_dr2 <- clinical_dr %>%
#  mutate(Surv = Surv*100)
# % time above target
# only include SS dosing
p <- ggplot() +
geom_point(data = filter(tab_plot, STDAY==7), aes(x = AMT, y = perc_TAM, color="MIC"), size=1.5, shape=1) +
geom_line(data = filter(tab_plot, STDAY==7), aes(x = AMT, y = perc_TAM, color="MIC"), linewidth=0.5) +
geom_point(data = filter(tab_plot, STDAY==7), aes(x = AMT, y = perc_TAMAC, color="macIC90"), size=1.5, shape=1) +
geom_line(data = filter(tab_plot, STDAY==7), aes(x = AMT, y = perc_TAMAC, color="macIC90"), linewidth=0.5) +
geom_point(data = filter(tab_plot, STDAY==7), aes(x = AMT, y = perc_TAE, color="EC50"), size=1.5, shape=1) +
geom_line(data = filter(tab_plot, STDAY==7), aes(x = AMT, y = perc_TAE, color="EC50"), linewidth=0.5) +
geom_point(data = filter(tab_plot, STDAY==7), aes(x = AMT, y = perc_TACAS50, color="casMBC50"), size=1.5, shape=1) +
geom_line(data = filter(tab_plot, STDAY==7), aes(x = AMT, y = perc_TACAS50, color="casMBC50"), linewidth=0.5) +
# clinical dose-response
#  geom_line(data = filter(clinical_dr2, RISKGRP != "Med Risk1", Regimen != "HPZE"), aes(x=Dose, y=Surv, linetype = RISKGRP)) +
scale_x_continuous(breaks = seq(0, 5000, 500)) +
scale_y_continuous(breaks = seq(0, 100, 10), limits=c(0,100)) +
# geom_hline(yintercept = 90, linetype="dashed") +
# geom_hline(yintercept = 50, linetype="dashed") +
geom_hline(yintercept = 10, linetype="dashed") +
# annotate("text", x = 5000, y = 93, label="ED90", size=3.5) +
# annotate("text", x = 5000, y = 53, label="ED50", size=3.5) +
annotate("text", x = 5000, y = 13, label="ED10", size=3.5) +
labs(color = "Potency target", linetype = "Risk Group") +
ylab("Percent time above target over 24 hours\nSurvival probability") +
xlab("Dose (mg)") +
ggtitle("RPT Caseum") +
scale_color_manual(values = color_mapping,
breaks = c("MIC", "macIC90", "EC50", "casMBC50")) +
theme_bw() +
theme(axis.title = element_text(size=12),
axis.text = element_text(size=10))
# get intersection per target
crossing_points <- sapply(percent_columns, function(col) {
interpolate_x(data$dose, data[[col]], target_y3)
})
names(crossing_points) <- c("MIC", "macIC90", "EC50", "casMBC50")
print(crossing_points)
# add the vertical lines and annotations for each crossing point
x_base <- max(data$dose) + 100
y_base <- 35
y_spacing <- 5
for (i in seq_along(names(crossing_points))) {
label <- names(crossing_points)[i]
if(!is.na(crossing_points[[label]])) {
p <- p +
annotate("text", x = x_base, y = y_base - (i-1)*y_spacing,
label = paste(label, "=", round(crossing_points[[label]], 2), "mg"), hjust = 1,
color = color_mapping[label], size = 3)
}
}
p
