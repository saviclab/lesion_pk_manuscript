;; 1. Based on: B008
;; 2. Description: + DOSE on F Power
;; x1. Author: 
;; Date: 2019-10-14 04:25:45
$PROBLEM    Covariate Model Development
$INPUT      SUBJID=DROP TIME DV ID EVID MDV AMT II ADDL DOSE POP TAD
$DATA      ppkdat_2019-10-12.csv IGNORE=@
$SUBROUTINE ADVAN4 TRANS4
$PK  

TVKA    = THETA(1)
TVCL    = THETA(2)
TVV2    = THETA(3)
TVQ     = THETA(4)
TVV3    = THETA(5)
TVALAG1 = THETA(6)

KA    =  TVKA    * EXP(ETA(1)) ;
CL    =  TVCL    * EXP(ETA(2)) ;
V2    =  TVV2    * EXP(ETA(3)) ;
Q     =  TVQ     * EXP(ETA(4)) ;
V3    =  TVV3    * EXP(ETA(5)) ;
ALAG1 =  TVALAG1 * EXP(ETA(6)) ;

S2 = (V2/1000)

TVF1 = 1
F1    =  TVF1* (DOSE/60)**THETA(7)     * EXP(ETA(7)) ;

$ERROR  
EPS_Y = EPS(1)
IPRED = F
W = IPRED
Y = IPRED+W*EPS_Y
IRES = DV - IPRED
IWRES = IRES/W

$THETA  (0,0.3,100) ; th1-KA: Absorption Rate Constant (1/hr)
 (0,15.3,1000) ; th2-CL: Clearance (L/hr)
 (0,228,1000) ; th3-V2: Central Volume of Distribution (L)
 (0,15.3,1000) ; th4-Q : Iner-Comparmental Clearance (L/hr)
 (0,300,1000) ; th5-V3: Peripheral Volume of Distribution (L)
 (0,0.1,10) ; th6-ALAG1: Absorption Lag Time (hr)
 (-10,-1,10) ; th7-F1-DOSE: Power Exponent
;; Structual Parameter
;; Covariate Effect
$OMEGA  0.1  ; eta1-IIV in KA
 0.1  ; eta2-IIV in CL
 0  FIX  ; eta3-IIV in V2
 0  FIX  ; eta4-IIV in Q
 0.1  ; eta5-IIV in V3
 0.1  ; eta6-IIV in ALAG1
 0.1  ; eta7-IIV in F1
$SIGMA  0.109  ; eps1-RV, Proportional
$ESTIMATION METHOD=COND NSIG=3 SIGL=9 MAXEVALS=9999 PRINT=10 NOABORT
            INTER
$COVARIANCE
$TABLE      ID TIME TAD EVID MDV IPRED IRES IWRES CWRES NPDE NOPRINT
            ONEHEADER FILE=sdtabC001
$TABLE      ID ETAS(1:LAST) CL KA V2 Q V3 ALAG1 ONEHEADER NOPRINT
            FILE=patabC001
$TABLE      ID ETAS(1:LAST) ONEHEADER NOPRINT FILE=cotabC001
$TABLE      ID ETAS(1:LAST) DOSE POP ONEHEADER NOPRINT FILE=catabC001


