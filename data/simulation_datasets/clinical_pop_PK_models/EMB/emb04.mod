;;; 2. Description: ETH 1 cmt IIV on CL, V, KA +ALAG1
;; x1. Author: Silver
;; 1. Based on: 1
$SIZES		PD=-100
$PROBLEM    Ethambutol 1 comp PK
$INPUT      ID USUBJIDNEW FIRSTDDATE=DROP NDATE=DROP NTIME=DROP DAY DV MDV EVID AMT COMPAR LLOQ BLOQ
            ACTTIME TAF SITE AFRICAN ARM AGE SEX RACE HIV CD4 VIRALLOAD HT WT BMI CAVITY
            CXRCLASS CXREXTNT SMEAR KARNOFSKY AESAE DIABETES ALCOHOL
            DOSEESTX DTC NDOT VOMIT DRUG DOSER DOSEP DOSEH DOSEZ DOSEE DOSEM TIME TAD TRAIN_FLAG NO_PK DIABETES2
$DATA       ../data/prelim_data_EMB_20221217_D.csv 
			IGNORE=@ 
			IGNORE(TAD.GT.13)
$SUBROUTINE ADVAN6 TOL=5
$MODEL      NCOMP=2 COMP=(ABS,DEFDOSE) COMP=(CENTRAL,DEFOBS) 
$PK



;; F1RACE-DEFINITION START
IF(RACE.EQ.1.0000E+00) F1RACE = 1  ; Most common
IF(RACE.EQ.5.0000E+00) F1RACE = ( 1 + THETA(7))
IF(RACE.EQ.2.0000E+00) F1RACE = 1 
IF(RACE.EQ.4.0000E+00) F1RACE = 1
IF(RACE.EQ.3.0000E+00) F1RACE = 1
;;; F1RACE-DEFINITION END



;;; F1-RELATION START
F1COV=F1RACE
;;; F1-RELATION END


;;; CLDIABETES-DEFINITION START
IF(DIABETES2.EQ.0.0000E+00) CLDIABETES2 = 1  ; Most common
IF(DIABETES2.EQ.1.0000E+00) CLDIABETES2 = ( 1 + THETA(8))
;;; CLDIABETES-DEFINITION END


;;; CLWT-DEFINITION START
CLWT = EXP(THETA(9)*(WT - 53))
;;; CLWT-DEFINITION END


;;; CL-RELATION START
CLCOV=CLDIABETES2*CLWT
;;; CL-RELATION END




TVALAG1 = THETA(6)
ALAG1 = TVALAG1 * EXP(ETA(5))

TVCL = THETA(3) * CLCOV
CL = TVCL * EXP(ETA(1))

TVV = THETA(4)
V = TVV*EXP(ETA(2))

TVKA = TVCL/TVV + THETA(5)
KA = TVKA*EXP(ETA(3))

KE = CL/V  


S2 = V
TVF1 = 1 * F1COV
F1 = TVF1 * EXP(ETA(4))


$DES      
DADT(1)=-KA*A(1)
DADT(2)= KA*A(1)-KE*A(2)

$ERROR         

IPRED=A(2)/V

WA=THETA(1) 
WP=THETA(2)
W = SQRT(WA**2+(WP*IPRED)**2)
IRES=DV-IPRED
IWRES=IRES/W
Y = IPRED + W*EPS(1)


$THETA  
0 FIX        ; 1 Additive Error mg/L
(0,0.5288)	 ; 2 Proportional Error
(0,15.69893) ; 3 CL L/h
(0,50.6803)  ; 4 V L
(0,0.083198) ; 5 KA 1/h
(0,0.5)	  	 ; 6 ALAG1 h
(-1,-0.114561,5) ; F1RACE1
(-1,0.240567,5) ; CLDIABETES2
(-0.104662958772457,0.0269937,0.104662958772457) ; CLWT 



$OMEGA 
 0.10328  ; IIV CL 
 0.1      ; IIV V
 0.1 	  ; IIV KA
 0 FIX    ; IIV F1
 0 FIX	  ; IIV ALAG1

$SIGMA  1  FIX
$ESTIMATION METHOD=1 INTERACTION PRINT=5 SIG=3 MAXEVAL=9999 NOABORT
$COVARIANCE PRINT=E UNCONDITIONAL
;Sim_start
; $SIM (12345) (54321) ONLYSIM NSUB=200
$TABLE USUBJIDNEW ID IPRED TIME	DAY	DRUG DOSER	DOSEP	DOSEH	DOSEZ	DOSEE	DOSEM TAD DV	MDV	EVID AMT 	LLOQ BLOQ ACTTIME	TAF	SITE AFRICAN
	ARM	AGE	SEX	RACE HIV CD4 VIRALLOAD HT WT  BMI	CAVITY	CXRCLASS	CXREXTNT	SMEAR	KARNOFSKY	AESAE	DIABETES DIABETES2 ALCOHOL	DOSEESTX 
	DTC	NDOT	VOMIT	PRED IPRED CL CLWT V KA F1 ALAG1 TVALAG1 TVF1 TVV TVCL TVKA WRES CWRES ETA1 ETA2 ETA3 ETA4 NOPRINT FORMAT= s1PE17.9 ONEHEADER FILE=emb04
	
