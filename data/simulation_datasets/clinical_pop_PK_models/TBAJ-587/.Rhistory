# set up
library(tidyverse)
library(xpose)
library(xpose4)
library(savictools)
WD <- "~/Savic_Lab Dropbox/Savic Lab Team Folder/TB_translation/Projects/Rabbit_lesion_PK/data/clinical_pop_PK_models/"
# read in TBAJ876 dataset as an example
ex_data <- read.csv(paste0(WD, "TBAJ876/NM_sim_dataset_with_METAB_UP_fasted.csv"))
# only simulating two doses: 200 and 400 mg
tbaj587_data <- ex_data %>%
mutate(DOSE =
ifelse(ID==1, 25,
ifelse(ID==2, 100, 400))) %>% # change doses
mutate(AMT =
ifelse(AMT>0, DOSE, 0)) %>%
select(-FED)
# only simulating two doses: 200 and 400 mg
tbaj587_data <- ex_data %>%
mutate(DOSE =
ifelse(ID==1, 25,
ifelse(ID==2, 100, 400))) %>% # change doses
mutate(AMT =
ifelse(AMT>0, DOSE, 0)) %>%
select(-FED) %>%
##### need to update AMT to nmol to match Leding model #####
mutate(AMT = AMT*1000*1000/614.5)
View(tbaj587_data)
# only simulating two doses: 200 and 400 mg
tbaj587_data <- ex_data %>%
mutate(DOSE_mg =
ifelse(ID==1, 25,
ifelse(ID==2, 100, 400))) %>% # change doses
mutate(AMT =
ifelse(AMT>0, DOSE, 0)) %>%
select(-FED) %>%
##### need to update AMT to nmol to match Leding model #####
mutate(AMT = AMT*1000*1000/614.5) %>%
# save data
write_csv(tbaj587_data, paste0(WD, "TBAJ587/TBAJ587_Sim_20240927.csv"))
View(tbaj587_data)
